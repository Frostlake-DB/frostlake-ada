with "frostlake.gpr";

project Frostlake_Tests is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   --  The driver's own suite, and the testkit corpus runner beside it.
   for Main use ("frostlake_tests.adb", "testkit_runner.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-g", "-O1", "-gnata");
   end Compiler;

end Frostlake_Tests;
